# Local target only. Use absolute paths matching your installation.
ENVIRONMENT=local
RUNTIME=docker
DB_NAME=odoo-local
OE_USER=odoo
COMPOSE_FILE=/srv/odoo-local/docker/docker-compose.yaml
COMPOSE_SERVICE=odoo-worker
ODOO_BIN=/opt/odoo/venv/bin/odoo
CONFIG_PATH=/opt/odoo/etc/odoo.conf
DATA_DIR=/opt/odoo/data
# For systemd instead: RUNTIME=systemd, OE_HOME=/opt/odoo-local,
# SERVICE_NAME=odoo-local, and matching CONFIG_PATH/DATA_DIR.
